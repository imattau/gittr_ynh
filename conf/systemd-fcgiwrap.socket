[Unit]
Description=gittr — dedicated fcgiwrap socket for HTTPS git

[Socket]
# NOT under $install_dir — confirmed live (nginx error log:
# "connect() ... failed (13: Permission denied)") that this was never
# actually about the socket file's own mode bits. $install_dir has
# default permissions 0750 (o=---, applied by the install_dir resource's
# own _ynh_apply_default_permissions) — www-data can't even traverse
# INTO the directory to reach the socket, regardless of SocketMode= /
# chmod on the socket file itself. Every earlier fix in this area
# (SocketUser=/SocketGroup=, SocketMode=0666, the ExecStartPost= chmod)
# was addressing the wrong layer.
#
# /run is always traversable, and since this is genuine systemd socket
# activation, systemd itself (root, PID 1) creates the file there before
# handing the fd to the unprivileged __APP__ service — sidesteps
# $install_dir's restrictive permissions entirely rather than trying to
# work around them. See doc/DECISIONS.md item 21.
ListenStream=/run/__APP__-fcgiwrap.sock
SocketMode=0666
RemoveOnStop=true

[Install]
WantedBy=sockets.target
