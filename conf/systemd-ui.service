[Unit]
Description=gittr — Next.js web UI
After=network.target __APP__-bridge.service
Requires=__APP__-bridge.service

[Service]
Type=simple
User=__APP__
Group=__APP__
WorkingDirectory=__INSTALL_DIR__/ui
ExecStart=__NODEJS_DIR__/node node_modules/.bin/next start -H 127.0.0.1 -p __PORT__
Restart=on-failure
RestartSec=5
# NEXT_PUBLIC_* vars are NOT set here — Next.js inlines them into the client
# bundle at `yarn build` time (see conf/ui.env.j2), not at process start.
# Next.js runs as the same __APP__ user/HOME as the bridge, so its default
# path resolution (checks /home/git-nostr/... first, then $HOME/...) would
# already fall through to the right place — but that first hardcoded check
# assumes a user literally named git-nostr, which ours isn't. Set these
# explicitly rather than rely on that fallback. See doc/DECISIONS.md item 3.
Environment=GIT_NOSTR_BRIDGE_DB=__INSTALL_DIR__/data/git-nostr-db.sqlite
Environment=GIT_NOSTR_BRIDGE_REPOS_DIR=__INSTALL_DIR__/repositories
# The UI's own /api/nostr/repo/event route proxies to the bridge's HTTP
# fast-lane (ui/src/pages/api/nostr/repo/event.ts:
# `process.env.BRIDGE_HTTP_PORT || "8080"`) for instant repo-event
# confirmation — without this, every push/create falls back to the slow
# ~10-60s relay-propagation path and the UI sits on "Published (Awaiting
# Bridge)" for the whole wait, confirmed live. Must match
# systemd-bridge.service's own BRIDGE_HTTP_PORT ($port_bridge_http),
# which won't always be upstream's hardcoded 8080 default if that port
# was already taken. See doc/DECISIONS.md item 23.
Environment=BRIDGE_HTTP_PORT=__PORT_BRIDGE_HTTP__
# Server-only (read at request time, unlike NEXT_PUBLIC_* above — safe to
# change here without a rebuild). This package doesn't install upstream's
# optional SEO-snapshot timer, so without this, every /sitemap.xml request
# does a live, uncached Nostr relay scan. See doc/DECISIONS.md item 7.
Environment=SITEMAP_SKIP_NOSTR=1
# GitHub OAuth / platform token / publisher blocklist — optional, may be
# unconfigured (all blank). In a file (mode 600, EnvironmentFile=), not
# inline Environment=, because it can hold secrets and unit files are
# world-readable. The leading '-' means "don't fail if the file is
# missing", though scripts/install always creates it.
EnvironmentFile=-__INSTALL_DIR__/ui/.env.runtime

# Sandboxing options to harden security.
# Details: https://www.freedesktop.org/software/systemd/man/systemd.exec.html
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
DevicePolicy=closed
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @debug @module @mount @obsolete @reboot @setuid @swap @cpu-emulation @privileged
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
