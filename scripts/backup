#!/bin/bash

# Keep this path for calling _common.sh inside the execution context of
# backup and restore scripts
source ../settings/scripts/_common.sh
source /usr/share/yunohost/helpers

ynh_print_info "Declaring files to be backed up..."

ynh_backup "$install_dir"

# This includes repositories/ (bare repos) and data/git-nostr-db.sqlite,
# which for busy instances could get large fast — there's no exclusion here
# yet. If that becomes a problem, exclude repositories/ and document a
# separate git-based mirroring strategy for repo content instead
# (see doc/DECISIONS.md item 5).

ynh_backup "/etc/nginx/conf.d/$domain.d/$app.conf"

# systemd units are NOT backed up here on purpose: scripts/restore
# regenerates them from templates instead of restoring a byte-for-byte copy,
# since they bake in an absolute path to the go/node binary that may change
# on restore (e.g. onto a fresh server) — see scripts/restore.
