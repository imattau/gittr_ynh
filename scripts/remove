#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Stopping and removing services"
ynh_remove_systemd_config --service="$app-ui"
ynh_remove_systemd_config --service="$app-ssh"
ynh_remove_systemd_config --service="$app-bridge"
yunohost service remove "$app-bridge" 2>/dev/null || true
yunohost service remove "$app-ssh" 2>/dev/null || true

ynh_script_progression "Removing NGINX configuration"
ynh_remove_nginx_config

ynh_script_progression "Removing app main directory"
ynh_secure_remove --file="$install_dir"

# No explicit Go/Node.js/apt removal here — resources.go, resources.nodejs,
# and resources.apt are deprovisioned automatically as part of the standard
# app-removal resource lifecycle. See doc/DECISIONS.md item 9.

ynh_script_progression "Removal complete"
