#!/bin/bash

source _common.sh
source /usr/share/yunohost/helpers

ynh_script_progression "Stopping services"
ynh_systemctl --service="$app-ui" --action="stop" --log_path="systemd"
ynh_systemctl --service="$app-ssh" --action="stop" --log_path="systemd"
ynh_systemctl --service="$app-bridge" --action="stop" --log_path="systemd"
# Fine if this doesn't exist yet (upgrading from before HTTPS git existed) —
# ynh_systemctl's stop path is a no-op for an already-inactive/unknown unit.
ynh_systemctl --service="$app-fcgiwrap" --action="stop" --log_path="systemd"

ynh_script_progression "Updating source files"
# Keep the bridge/UI config, data (repositories, sqlite db), and the
# dedicated sshd's host key + authorized_keys across upgrades.
ynh_setup_source --dest_dir="$install_dir" \
	--keep="$bridge_config_dir data repositories ssh .ssh"

ynh_script_progression "Rebuilding git-nostr-bridge"
# Go is a manifest resource, already on $PATH from sourcing the helpers
# above — see doc/DECISIONS.md item 9. $HOME isn't set here either, so
# point the module cache at the same scratch dir install uses — see
# doc/DECISIONS.md item 10.
export GOPATH="/var/cache/yunohost/gittr-go-build"
export GOCACHE="$GOPATH/build-cache"
mkdir -p "$GOPATH"
pushd "$install_dir/$bridge_dir"
	make git-nostr-bridge
popd

ynh_script_progression "Reading optional-feature settings"
# github_client_id/secret/platform_token/publisher_blocklist read as empty
# is correct if unset. blossom_url falls back here for apps upgrading from
# before this setting existed — see doc/DECISIONS.md item 8.
blossom_url=$(ynh_app_setting_get --app=$app --key=blossom_url)
blossom_url="${blossom_url:-$DEFAULT_BLOSSOM_URL}"
ynh_app_setting_set --app=$app --key=blossom_url --value="$blossom_url"

ynh_script_progression "Rebuilding the UI"
# Node.js is likewise a manifest resource, already on $PATH.
ynh_config_add --template="ui.env.j2" \
	--destination="$install_dir/ui/.env.production.local"
ynh_config_add --template="ui-runtime.env.j2" \
	--destination="$install_dir/ui/.env.runtime"
pushd "$install_dir/ui"
	corepack enable
	corepack prepare yarn@$YARN_VERSION --activate
	ynh_exec_and_print_stderr_only_if_error yarn install --frozen-lockfile
	ynh_exec_and_print_stderr_only_if_error yarn build
popd

ynh_script_progression "Updating bridge config"
nostr_relays_json_array=$(csv_to_json_array "$nostr_relays")
git_repo_owners_json_array=$(csv_to_json_array "$repo_owner_pubkey")
ynh_config_add --template="bridge-config.json.j2" \
	--destination="$install_dir/$bridge_config_dir/$bridge_config_file"

ynh_script_progression "Updating sshd configuration"
ynh_config_add --template="sshd_config.j2" \
	--destination="$install_dir/ssh/sshd_config"

ynh_script_progression "Updating HTTPS git (dedicated fcgiwrap)"
mkdir -p "$install_dir/bin"
ynh_config_add --template="git-http-backend-quiet" \
	--destination="$install_dir/bin/git-http-backend-quiet"
chmod +x "$install_dir/bin/git-http-backend-quiet"
ynh_config_add --template="systemd-fcgiwrap.socket" \
	--destination="/etc/systemd/system/$app-fcgiwrap.socket"
systemctl enable "$app-fcgiwrap.socket" --quiet

ynh_script_progression "Updating systemd configuration"
ynh_config_add_systemd --service="$app-ui" --template="systemd-ui.service"
ynh_config_add_systemd --service="$app-bridge" --template="systemd-bridge.service"
ynh_config_add_systemd --service="$app-ssh" --template="systemd-ssh.service"
ynh_config_add_systemd --service="$app-fcgiwrap" --template="systemd-fcgiwrap.service"

ynh_script_progression "Updating NGINX configuration"
ynh_config_add_nginx

ynh_script_progression "Setting permissions"
chown -R "$app:$app" "$install_dir"
chmod 700 "$install_dir/.ssh" "$install_dir/ssh"
chmod 600 "$install_dir/ssh/ssh_host_ed25519_key" "$install_dir/ssh/sshd_config"
chmod 600 "$install_dir/$bridge_config_dir/$bridge_config_file"
chmod 600 "$install_dir/ui/.env.runtime"

ynh_script_progression "Starting services"
yunohost service add "$app-bridge" --description="gitnostr bridge (repo/SSH-key sync from Nostr)" --log="/var/log/$app/bridge.log"
yunohost service add "$app-ssh" --description="dedicated sshd for git-nostr-ssh"
yunohost service add "$app-fcgiwrap" --description="dedicated fcgiwrap for HTTPS git"
ynh_systemctl --service="$app-bridge" --action="start" --log_path="systemd"
ynh_systemctl --service="$app-ui" --action="start" --log_path="systemd"
ynh_systemctl --service="$app-ssh" --action="start" --log_path="systemd"
systemctl start "$app-fcgiwrap.socket"

ynh_script_progression "Upgrade complete"
